@model Aiursoft.HowToCookViewer.Models.HomeViewModels.IndexViewModel

@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
    <link rel="stylesheet" href="~/styles/site.css"/>
    <link rel="stylesheet" href="~/styles/marketing.css"/>
}

<vc:marketing-navbar></vc:marketing-navbar>

@* ── Hero / Search ─────────────────────────────────────────────────── *@
<section class="landing-intro text-bg-dark pt-5 pb-5">
    <div class="container py-4">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="mb-3">
                    <span class="badge badge-subtle-primary p-1">@Localizer["Open Source"]</span>
                    <span class="badge badge-subtle-primary p-1">@Localizer["Free Forever"]</span>
                    <span class="badge badge-subtle-primary p-1">@Localizer["MIT License"]</span>
                </div>
                <h1 class="display-4 fw-bold text-white mb-3">
                    @Localizer["Explore {0} Free Recipes", Model.TotalRecipes.ToString("N0")]
                </h1>
                <p class="lead text-white-50 mb-4">
                    @Localizer["Community-sourced, AI-translated, and free forever."]
                </p>
                <form method="get" asp-action="Index" asp-controller="Dashboard">
                    <div class="input-group input-group-lg mx-auto" style="max-width:640px;">
                        <span class="input-group-text bg-white border-end-0">
                            <i data-lucide="search" style="width:20px;height:20px;"></i>
                        </span>
                        <input type="text"
                               name="q"
                               class="form-control border-start-0 ps-0"
                               placeholder="@Localizer["Search recipes (e.g. 西红柿, 鸡蛋, 豆腐…)"]"
                               autofocus/>
                        <button class="btn btn-primary px-4" type="submit">@Localizer["Search"]</button>
                    </div>
                </form>
                <div class="mt-3">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-light btn-sm btn-pill">
                        <i class="align-middle me-1" data-lucide="grid"></i>
                        @Localizer["Browse All Recipes"]
                    </a>
                    <a asp-controller="Home" asp-action="SelfHost" class="btn btn-outline-light btn-sm btn-pill ms-2">
                        <i class="align-middle me-1" data-lucide="server"></i>
                        @Localizer["Self Host"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Features ──────────────────────────────────────────────────────── *@
<section class="py-6 bg-light">
    <div class="container">
        <div class="mb-5 text-center">
            <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["What Makes It Special"]</span>
            <h2 class="h1">@Localizer["Cook with Confidence."]</h2>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3 h-100">
                    <div class="landing-feature me-3">
                        <i data-lucide="languages"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["AI-Translated"]</h4>
                        <p class="fs-lg">@Localizer["Every recipe is automatically translated into 27 languages using AI, so you can cook in your native language."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3 h-100">
                    <div class="landing-feature me-3">
                        <i data-lucide="users"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Community Driven"]</h4>
                        <p class="fs-lg">@Localizer["All recipes come from the HowToCook open-source project. Anyone can contribute, improve, or fork it."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3 h-100">
                    <div class="landing-feature me-3">
                        <i data-lucide="code-2"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Fully Open Source"]</h4>
                        <p class="fs-lg">@Localizer["Both the recipes and this viewer are open-source. Transparent, collaborative, and free forever."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3 h-100">
                    <div class="landing-feature me-3">
                        <i data-lucide="search-check"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Powerful Search"]</h4>
                        <p class="fs-lg">@Localizer["Search by ingredient, dish name, or category to find exactly what you want to cook today."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3 h-100">
                    <div class="landing-feature me-3">
                        <i data-lucide="image"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Rich with Photos"]</h4>
                        <p class="fs-lg">@Localizer["Browse recipes with beautiful cover photos and detailed step-by-step visual instructions."]</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-4 d-flex">
                <div class="d-flex align-items-start py-3 h-100">
                    <div class="landing-feature me-3">
                        <i data-lucide="github"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h4 class="mt-0">@Localizer["Edit on GitHub"]</h4>
                        <p class="fs-lg">@Localizer["Spot a mistake or want to improve a recipe? Edit it directly on GitHub and help the whole community."]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Featured Recipes ──────────────────────────────────────────────── *@
@if (Model.FeaturedRecipes.Count > 0)
{
    <section class="py-6 border-top">
        <div class="container">
            <div class="mb-4 text-center">
                <span class="text-uppercase text-primary text-sm fw-medium mb-1 d-block">@Localizer["Community Favourites"]</span>
                <h2 class="h1">@Localizer["Most Loved Recipes"]</h2>
                <p class="text-muted">@Localizer["Browse what the community loves most."]</p>
            </div>

            <div class="row g-3">
                @await Html.PartialAsync("_RecipeCards", new Aiursoft.HowToCookViewer.Models.RecipesViewModels.RecipeCardsViewModel
                {
                    Recipes = Model.FeaturedRecipes,
                    LikeCounts = Model.LikeCounts,
                    LocalizedNames = Model.LocalizedNames,
                    LocalizedDescriptions = Model.LocalizedDescriptions
                })
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg btn-pill">
                    <i class="align-middle me-2" data-lucide="utensils"></i>
                    @Localizer["Browse All Recipes"]
                </a>
                <a asp-controller="Home" asp-action="SelfHost" class="btn btn-outline-primary btn-lg btn-pill ms-2">
                    <i class="align-middle me-2" data-lucide="server"></i>
                    @Localizer["Self Host"]
                </a>
            </div>
        </div>
    </section>
}

<vc:marketing-footer></vc:marketing-footer>

@* Hidden CSRF token so fallback anti-CSRF logic in integration tests can find it *@
<div hidden>@Html.AntiForgeryToken()</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
    <script src="~/scripts/site.js"></script>
}

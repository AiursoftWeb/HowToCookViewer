@model Aiursoft.HowToCookViewer.Models.RecipesViewModels.IndexViewModel
@using Aiursoft.HowToCookViewer.Services.FileStorage
@inject StorageService Storage

<div class="container-fluid p-4">
    <div class="row mb-3">
        <div class="col">
            <h3>
                <i class="align-middle me-2" data-lucide="utensils"></i>
                @Model.CategoryDisplayName
            </h3>
            <p class="text-muted mb-0">@Localizer["Total {0} recipes", Model.TotalCount]</p>
        </div>
        @if (Model.TotalCount > 0)
        {
            <div class="col-auto align-self-center">
                <a asp-controller="Recipes" asp-action="Random"
                   asp-route-category="@Model.Category"
                   asp-route-difficulty="@Model.Difficulty"
                   asp-route-sortBy="@Model.SortBy"
                   class="btn btn-outline-primary">
                    <i class="align-middle me-1" data-lucide="shuffle"></i>
                    @Localizer["Random Recipe"]
                </a>
            </div>
        }
    </div>

    @if (Model.Recipes.Count == 0)
    {
        <div class="alert alert-info">
            <i class="align-middle me-2" data-lucide="info"></i>
            @Localizer["No recipes yet. The background indexing job may still be running."]
        </div>
    }
    else
    {
        <div class="row g-3" id="recipe-grid">
            @await Html.PartialAsync("_RecipeCards", new Aiursoft.HowToCookViewer.Models.RecipesViewModels.RecipeCardsViewModel
            {
                Recipes = Model.Recipes,
                LikeCounts = Model.LikeCounts,
                LocalizedNames = Model.LocalizedNames,
                LocalizedDescriptions = Model.LocalizedDescriptions
            })
        </div>

        @if (Model.HasMore)
        {
            <div id="load-sentinel"
                 class="text-center py-4"
                 style="min-height:60px;"
                 data-category="@(Model.Category ?? "")"
                 data-difficulty="@(Model.Difficulty?.ToString() ?? "")"
                 data-sort-by="@(Model.SortBy ?? "")">
                <div class="spinner-border text-secondary" role="status" style="display:none;" id="load-spinner">
                    <span class="visually-hidden">@Localizer["Loading…"]</span>
                </div>
            </div>

            <script>
            (function () {
                let nextPage = 2;
                let loading = false;
                let hasMore = true;

                const grid     = document.getElementById('recipe-grid');
                const sentinel = document.getElementById('load-sentinel');
                const spinner  = document.getElementById('load-spinner');

                const category   = sentinel.dataset.category   || null;
                const difficulty = sentinel.dataset.difficulty || null;
                const sortBy     = sentinel.dataset.sortBy     || null;

                function buildUrl(page) {
                    const params = new URLSearchParams({ page });
                    if (category)   params.set('category',   category);
                    if (difficulty) params.set('difficulty', difficulty);
                    if (sortBy)     params.set('sortBy',     sortBy);
                    return '/Recipes/LoadMore?' + params.toString();
                }

                async function loadMore() {
                    if (loading || !hasMore) return;
                    loading = true;
                    spinner.style.display = '';

                    try {
                        const resp = await fetch(buildUrl(nextPage));
                        if (!resp.ok) { hasMore = false; return; }

                        const html = await resp.text();
                        hasMore = resp.headers.get('X-Has-More') === 'true';
                        nextPage++;

                        const tmp = document.createElement('div');
                        tmp.innerHTML = html;
                        while (tmp.firstChild) grid.appendChild(tmp.firstChild);

                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    } finally {
                        loading = false;
                        spinner.style.display = 'none';
                        if (!hasMore) sentinel.style.display = 'none';
                    }
                }

                const observer = new IntersectionObserver(
                    entries => { if (entries[0].isIntersecting) loadMore(); },
                    { rootMargin: '200px' }
                );
                observer.observe(sentinel);
            })();
            </script>
        }
    }
</div>


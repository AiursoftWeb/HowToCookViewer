@model Aiursoft.HowToCookViewer.Models.RecipesViewModels.IndexViewModel

<div class="container-fluid p-4">
    <div class="row mb-3">
        <div class="col">
            <h3>
                <i class="align-middle me-2" data-lucide="utensils"></i>
                @Model.CategoryDisplayName
            </h3>
            <p class="text-muted mb-0">@Localizer["Total {0} recipes", Model.TotalCount]</p>
        </div>
        @if (Model.TotalCount > 0)
        {
            <div class="col-auto align-self-center">
                <a asp-controller="Recipes" asp-action="Random"
                   asp-route-category="@Model.Category"
                   asp-route-difficulty="@Model.Difficulty"
                   asp-route-sortBy="@Model.SortBy"
                   class="btn btn-outline-primary">
                    <i class="align-middle me-1" data-lucide="shuffle"></i>
                    @Localizer["Random Recipe"]
                </a>
            </div>
        }
        <div class="col-auto align-self-center">
            <a href="https://github.com/Anduin2017/HowToCook/fork" target="_blank" rel="noopener noreferrer"
               class="btn btn-success">
                <i class="align-middle me-1" data-lucide="plus-circle"></i>
                @Localizer["Add Recipe"]
            </a>
        </div>
    </div>

    <div class="alert alert-primary alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
        <div class="alert-message">
            <h4 class="alert-heading">@Localizer["Open Community Cookbook"]</h4>
            <p class="mb-0">@Localizer["Anyone can freely add or edit recipes in HowToCook for free — just fork the repository on GitHub, make your changes, and submit a pull request. Your recipe will be available to everyone!"]</p>
        </div>
    </div>

    @if (Model.Recipes.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <div class="alert-message">
                <i class="align-middle me-2" data-lucide="info"></i>
                @Localizer["No recipes yet. The background indexing job may still be running."]
            </div>
        </div>
    }
    else
    {
        <div class="row g-3" id="recipe-grid">
            @await Html.PartialAsync("_RecipeCards", new Aiursoft.HowToCookViewer.Models.RecipesViewModels.RecipeCardsViewModel
            {
                Recipes = Model.Recipes,
                LikeCounts = Model.LikeCounts,
                LocalizedNames = Model.LocalizedNames,
                LocalizedDescriptions = Model.LocalizedDescriptions
            })
        </div>

        @if (Model.HasMore)
        {
            <div id="load-sentinel"
                 class="text-center py-4"
                 style="min-height:60px;"
                 data-category="@(Model.Category ?? "")"
                 data-difficulty="@(Model.Difficulty?.ToString() ?? "")"
                 data-sort-by="@(Model.SortBy ?? "")">
                <div class="spinner-border text-secondary" role="status" style="display:none;" id="load-spinner">
                    <span class="visually-hidden">@Localizer["Loading…"]</span>
                </div>
                <div id="load-error" class="d-none mt-2">
                    <p class="text-danger mb-2" role="alert">@Localizer["More recipes could not be loaded. Please try again."]</p>
                    <button id="retry-load" type="button" class="btn btn-outline-primary">@Localizer["Try again"]</button>
                </div>
            </div>
        }
    }
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@section Scripts {
    <script src="~/scripts/recipe-list.js" asp-append-version="true"></script>
}

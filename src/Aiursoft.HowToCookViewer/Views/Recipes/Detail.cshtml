@model Aiursoft.HowToCookViewer.Models.RecipesViewModels.DetailViewModel
@using Aiursoft.HowToCookViewer.Services.FileStorage
@inject StorageService Storage

<div class="container-fluid p-4">
    <div class="row mb-3">
        <div class="col-12 col-xl">
            <nav aria-label="@Localizer["breadcrumb"]">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Recipes/Index">@Localizer["All Recipes"]</a></li>
                    <li class="breadcrumb-item">
                        <a href="/Recipes/Index?category=@Model.Recipe.Category">
                            @Model.CategoryDisplayName
                        </a>
                    </li>
                    <li class="breadcrumb-item active">@(Model.LocalizedRecipe?.LocalizedName ?? Model.Recipe.Name)</li>
                </ol>
            </nav>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="col-12 col-xl-auto d-flex flex-wrap align-items-start gap-2">
                <a href="@Model.GitHubEditUrl" target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-secondary">
                    <i class="align-middle me-1" data-lucide="pencil"></i>
                    @Localizer["Edit on GitHub"]
                </a>
                @if (Model.ShowSimilarRecipesButton)
                {
                    <a href="/Recipes/Similar/@Model.Recipe.Id" class="btn btn-outline-primary">
                        <i class="align-middle me-1" data-lucide="search"></i>
                        @Localizer["Similar Recipes"]
                    </a>
                }
                <form asp-controller="Likes" asp-action="Toggle" method="post">
                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.IsLiked ? "btn-warning" : "btn-outline-warning")">
                        <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                        @(Model.IsLiked ? Localizer["Liked"] : Localizer["Like"])
                        <span class="badge @(Model.IsLiked ? "bg-white text-dark" : "bg-warning text-dark") ms-1">@Model.LikeCount</span>
                    </button>
                </form>
                <form asp-controller="Favorites" asp-action="Toggle" method="post">
                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.IsFavorited ? "btn-danger" : "btn-outline-danger")">
                        <i class="align-middle me-1" data-lucide="heart"></i>
                        @(Model.IsFavorited ? Localizer["Favorited"] : Localizer["Favorite"])
                    </button>
                </form>
            </div>
        }
        @if (User.Identity?.IsAuthenticated != true)
        {
            <div class="col-12 col-xl-auto d-flex flex-wrap align-items-start gap-2">
                <a href="@Model.GitHubEditUrl" target="_blank" rel="noopener noreferrer"
                   class="btn btn-outline-secondary">
                    <i class="align-middle me-1" data-lucide="pencil"></i>
                    @Localizer["Edit on GitHub"]
                </a>
                @if (Model.ShowSimilarRecipesButton)
                {
                    <a href="/Recipes/Similar/@Model.Recipe.Id" class="btn btn-outline-primary">
                        <i class="align-middle me-1" data-lucide="search"></i>
                        @Localizer["Similar Recipes"]
                    </a>
                }
                <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"
                   class="btn btn-outline-warning">
                    <i class="align-middle me-1" data-lucide="thumbs-up"></i>
                    @Localizer["Like"]
                    @if (Model.LikeCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@Model.LikeCount</span>
                    }
                </a>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-12 col-lg-8 offset-lg-2">
            <div class="card shadow-sm">
                <div class="card-body p-3 p-md-5">
                    @{
                        var difficultyLabel = Model.Recipe.Difficulty switch
                        {
                            <= 1 => Localizer["Beginner"],
                            2 => Localizer["Easy"],
                            3 => Localizer["Intermediate"],
                            4 => Localizer["Advanced"],
                            _ => Localizer["Expert"]
                        };
                    }
                    <dl class="row g-3 mb-4 pb-3 border-bottom">
                        <div class="col-sm-6">
                            <dt class="text-muted small fw-normal">@Localizer["Difficulty"]</dt>
                            <dd class="mb-0">
                                <span class="fs-4 fw-semibold">@Model.Recipe.Difficulty</span>
                                <span class="text-muted ms-2">@difficultyLabel</span>
                            </dd>
                        </div>
                        @if (Model.Recipe.Calories.HasValue)
                        {
                            var calorieLabel = Model.Recipe.Calories.Value switch
                            {
                                <= 200 => Localizer["Light"],
                                <= 500 => Localizer["Moderate"],
                                _ => Localizer["Hearty"]
                            };
                            <div class="col-sm-6">
                                <dt class="text-muted small fw-normal">@Localizer["Estimated Calories"]</dt>
                                <dd class="mb-0">
                                    <span class="fs-4 fw-semibold">@Model.Recipe.Calories.Value.ToString("F0")</span>
                                    <span class="text-muted">@Localizer["kcal"]</span>
                                    <span class="text-muted ms-2">@calorieLabel</span>
                                </dd>
                            </div>
                        }
                    </dl>

                    <div class="recipe-markdown markdown-content">
                        @Html.Raw(Model.RenderedMarkdown)
                    </div>
                </div>
                <div class="px-4 px-md-5 pb-3">
                    <div class="alert alert-primary alert-dismissible" role="alert">
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
                        <div class="alert-message">
                            <h4 class="alert-heading">@Localizer["Community Content"]</h4>
                            <p class="mb-0">
                                @Localizer["The copyright of this recipe belongs to the community and is released into the public domain under The Unlicense — free to use for any purpose without any restrictions."]
                                <a href="https://github.com/Anduin2017/HowToCook/blob/master/LICENSE" target="_blank" rel="noopener noreferrer">@Localizer["Click here to view the legal information."]</a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted small">
                    <i class="align-middle me-1" data-lucide="git-commit-horizontal"></i>
                    @Localizer["Last updated:"] <label data-utc-time="@Model.Recipe.FileLastModified.ToHtmlDateTime()"></label>
                </div>
            </div>

            <!-- Contributors Section -->
            @if (Model.Contributors.Count > 0)
            {
                <div class="mt-4">
                    <h5 class="mb-3 d-flex align-items-center">
                        <div>
                            <i class="align-middle me-1" data-lucide="users"></i>
                            @Localizer["Contributors"]
                        </div>
                        @if (!string.IsNullOrEmpty(Model.GitHubHistoryUrl))
                        {
                            <a href="@Model.GitHubHistoryUrl" target="_blank" rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-secondary ms-3">
                                <i class="align-middle me-1" data-lucide="history"></i>
                                @Localizer["Change History"]
                            </a>
                        }
                    </h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var contributor in Model.Contributors)
                        {
                            <a href="@contributor.GitHubProfileUrl" target="_blank" rel="noopener noreferrer"
                               title="@contributor.Name (@contributor.CommitCount @Localizer["commits"])"
                               class="d-inline-block">
                                <img src="@contributor.AvatarUrl" alt="@contributor.Name"
                                     class="rounded-circle border shadow-sm" width="40" height="40"
                                     style="object-fit: cover;" />
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Comments Section
 -->
            <div id="comments" class="mt-4">
                <h5 class="mb-3">
                    <i class="align-middle me-1" data-lucide="message-circle"></i>
                    @Localizer["Comments"] (@Model.Comments.Count)
                </h5>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="card mb-4">
                        <div class="card-body">
                            <form asp-controller="Comments" asp-action="Post" method="post">
                                <input type="hidden" name="recipeId" value="@Model.Recipe.Id" />
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <textarea name="content" class="form-control" rows="3"
                                              placeholder="@Localizer["Write your comment…"]" maxlength="1000" required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">@Localizer["Post Comment"]</button>
                            </form>
                        </div>
                    </div>
                }

                @foreach (var comment in Model.Comments)
                {
                    <div class="card mb-3" id="comment-@comment.Id">
                        <div class="card-body">
                            <div class="d-flex gap-3">
                                <img src="@Storage.RelativePathToInternetUrl(comment.User.AvatarRelativePath)?w=72&square=true"
                                     alt="@(comment.User.DisplayName)"
                                     class="rounded-circle flex-shrink-0"
                                     width="40" height="40" />
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div>
                                            <strong class="me-2">@(comment.User.DisplayName)</strong>
                                            <small class="text-muted"><label data-utc-time="@comment.CreatedAt.ToHtmlDateTime()"></label></small>
                                        </div>
                                        @if (User.Identity?.IsAuthenticated == true &&
                                             User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == comment.UserId)
                                        {
                                            <form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline">
                                                <input type="hidden" name="commentId" value="@comment.Id" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link btn-sm text-danger p-0"
                                                        onclick="return confirm('@Localizer["Are you sure you want to delete this comment and all its replies?"]')">@Localizer["Delete"]</button>
                                            </form>
                                        }
                                    </div>
                                    <p class="mb-2">@comment.Content</p>

                                    <!-- Replies -->
                                    @if (comment.Replies.Count > 0)
                                    {
                                        <div class="border-start ps-3 mt-2">
                                            @foreach (var reply in comment.Replies.OrderBy(r => r.CreatedAt))
                                            {
                                                <div class="d-flex gap-2 mb-2 pt-2" id="comment-@reply.Id">
                                                    <img src="@(Storage.RelativePathToInternetUrl(reply.User.AvatarRelativePath))?w=48&square=true"
                                                         alt="@(reply.User.DisplayName)"
                                                         class="rounded-circle flex-shrink-0"
                                                         width="32" height="32" />
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <div>
                                                                <strong class="me-2">@(reply.User.DisplayName)</strong>
                                                                <small class="text-muted"><label data-utc-time="@reply.CreatedAt.ToHtmlDateTime()"></label></small>
                                                            </div>
                                                            @if (User.Identity?.IsAuthenticated == true &&
                                                                 User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == reply.UserId)
                                                            {
                                                                <form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline">
                                                                    <input type="hidden" name="commentId" value="@reply.Id" />
                                                                    @Html.AntiForgeryToken()
                                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0"
                                                                            onclick="return confirm('@Localizer["Are you sure you want to delete this reply?"]')">@Localizer["Delete"]</button>
                                                                </form>
                                                            }
                                                        </div>
                                                        <p class="mb-0">@reply.Content</p>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <!-- Reply Form -->
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <div class="mt-2">
                                            <a class="btn btn-link btn-sm p-0 text-secondary toggle-reply"
                                               data-target="reply-form-@comment.Id">@Localizer["Reply"]</a>
                                            <div id="reply-form-@comment.Id" class="d-none mt-2">
                                                <form asp-controller="Comments" asp-action="Post" method="post">
                                                    <input type="hidden" name="recipeId" value="@Model.Recipe.Id" />
                                                    <input type="hidden" name="parentCommentId" value="@comment.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <div class="mb-1">
                                                        <textarea name="content" class="form-control form-control-sm" rows="2"
                                                                  placeholder="@string.Format(Localizer["Reply to {0}..."].Value, comment.User.DisplayName)"
                                                                  maxlength="1000" required></textarea>
                                                    </div>
                                                    <button type="submit" class="btn btn-secondary btn-sm">@Localizer["Send Reply"]</button>
                                                </form>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Comments.Count == 0)
                {
                    <p class="text-muted text-center py-3">@Localizer["No comments yet. Be the first to leave one!"]</p>
                }

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="text-center py-3">
                        <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)"
                           class="btn btn-outline-primary">
                            <i class="align-middle me-1" data-lucide="log-in"></i>
                            @Localizer["Login to comment"]
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ReSharper disable once Razor.SectionNotResolved *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section styles {
<link rel="stylesheet" href="~/node_modules/@@highlightjs/cdn-assets/styles/github.min.css" asp-append-version="true" />
<style>
.recipe-markdown img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
}
.recipe-markdown h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: 1rem; }
.recipe-markdown h2 { font-size: 1.3rem; font-weight: 600; margin-top: 2rem; margin-bottom: .75rem; border-bottom: 1px solid #dee2e6; padding-bottom: .4rem; }
.recipe-markdown ul, .recipe-markdown ol { padding-left: 1.5rem; }
.recipe-markdown li { margin-bottom: .25rem; }
.recipe-markdown p { line-height: 1.8; }

</style>
}

@* ReSharper disable once Razor.SectionNotResolved *@
@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
@{
    ViewData["MarkdownSelector"] = ".recipe-markdown";
    ViewData["MarkdownTheme"] = Context.Request.Cookies["prefer-dark"] == true.ToString() ? "dark" : "default";
}
<partial name="_MarkdownReaderAssets" />
<script>
document.querySelectorAll('.toggle-reply').forEach(btn => {
    btn.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.getElementById(this.dataset.target);
        if (target) target.classList.toggle('d-none');
    });
});

</script>
}

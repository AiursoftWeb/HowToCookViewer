@* ReSharper disable once Razor.SectionNotResolved *@
@section scripts {
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>
mermaid.initialize({ startOnLoad: false, theme: 'default' });

document.querySelectorAll('.toggle-reply').forEach(btn => {
    btn.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.getElementById(this.dataset.target);
        if (target) target.classList.toggle('d-none');
    });
});

(function() {
    const meter = document.querySelector('.difficulty-meter');
    if (!meter) return;

    const difficulty = parseInt(meter.dataset.difficulty) || 0;
    const icons = meter.querySelectorAll('.difficulty-icon');
    const label = document.getElementById('difficulty-label');

    const colors = {
        low: '#20c997',    // Teal
        medium: '#ffc107', // Yellow
        high: '#fd7e14',   // Orange
        extreme: '#dc3545' // Red
    };

    const levels = [
        "@Localizer["Beginner"]",
        "@Localizer["Easy"]",
        "@Localizer["Intermediate"]",
        "@Localizer["Advanced"]",
        "@Localizer["Expert"]"
    ];

    function getColor(d) {
        if (d <= 1) return colors.low;
        if (d <= 2) return colors.medium;
        if (d <= 3) return colors.high;
        return colors.extreme;
    }

    const finalColor = getColor(difficulty);
    label.textContent = levels[Math.min(Math.max(difficulty - 1, 0), 4)] || "@Localizer["Unknown"]";
    label.style.backgroundColor = finalColor;
    label.style.color = difficulty <= 2 ? '#212529' : '#fff';

    icons.forEach((icon, index) => {
        if (index < difficulty) {
            setTimeout(() => {
                icon.classList.add('active');
                icon.style.color = finalColor;
                if (difficulty >= 5) {
                    icon.classList.add('extreme');
                }
            }, index * 100);
        }
    });
})();

// ── Calorie Gauge ──────────────────────────────────────────────────
(function() {
    const wrapper = document.querySelector('.calorie-gauge-wrapper');
    if (!wrapper) return;

    const calories = parseFloat(wrapper.dataset.calories);
    const fillCircle = wrapper.querySelector('.calorie-gauge-fill');
    const valueDisplay = wrapper.querySelector('.calorie-value-display');
    const levelBadge = document.getElementById('calorie-level-badge');

    const circumference = 2 * Math.PI * 52; // ~326.73

    function getCalorieLevel(kcal) {
        if (kcal <= 200) return { color: '#20c997', label: '@Localizer["Light"]', glow: 'rgba(32,201,151,0.4)' };
        if (kcal <= 500) return { color: '#F59E0B', label: '@Localizer["Moderate"]', glow: 'rgba(245,158,11,0.4)' };
        return { color: '#EF4444', label: '@Localizer["Hearty"]', glow: 'rgba(239,68,68,0.4)' };
    }

    const level = getCalorieLevel(calories);
    const maxRef = 1000;
    const ratio = Math.min(calories / maxRef, 1);
    const offset = circumference * (1 - ratio);

    // Animate fill
    setTimeout(() => {
        fillCircle.style.strokeDashoffset = offset;
        fillCircle.style.stroke = level.color;
        fillCircle.style.filter = 'drop-shadow(0 0 8px ' + level.glow + ')';
    }, 200);

    // Animate counter
    const duration = 1500;
    const startTime = performance.now();

    function animateCounter(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // easeOutCubic
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(calories * eased);
        valueDisplay.textContent = current;
        valueDisplay.style.color = level.color;
        if (progress < 1) {
            requestAnimationFrame(animateCounter);
        }
    }
    setTimeout(() => requestAnimationFrame(animateCounter), 200);

    // Badge
    levelBadge.textContent = level.label;
    levelBadge.style.backgroundColor = level.color;
    levelBadge.style.color = '#fff';

    // Interactive hover — pulse gauge
    wrapper.style.cursor = 'pointer';
    wrapper.addEventListener('mouseenter', () => {
        fillCircle.style.transform = 'scale(1.05)';
        fillCircle.style.transformOrigin = '60px 60px';
        fillCircle.style.transition = 'transform 0.3s ease, stroke-dashoffset 1.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), stroke 1.8s ease';
        wrapper.style.transform = 'scale(1.08)';
        wrapper.style.transition = 'transform 0.3s ease';
    });
    wrapper.addEventListener('mouseleave', () => {
        fillCircle.style.transform = 'scale(1)';
        wrapper.style.transform = 'scale(1)';
    });
})();

// Render mermaid diagrams on page load
document.addEventListener('DOMContentLoaded', function() {
    mermaid.run();
});
</script>
}


@model Aiursoft.HowToCookViewer.Models.DashboardViewModels.IndexViewModel
@using Aiursoft.HowToCookViewer.Services.FileStorage
@inject StorageService Storage

@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalResults / Aiursoft.HowToCookViewer.Models.DashboardViewModels.IndexViewModel.PageSize);
    var hasQuery = !string.IsNullOrWhiteSpace(Model.Query);
}

@* ── Hero / Search bar ─────────────────────────────────────────────── *@
<div class="jumbotron p-4 mb-4" style="background: linear-gradient(135deg,#1a1a2e 0%,#16213e 60%,#0f3460 100%); border-radius:.75rem;">
    <div class="container text-center py-3">
        <h1 class="display-5 fw-bold text-white mb-1">
            <i class="align-middle me-2" data-lucide="chef-hat"></i> @Localizer["Recipe Search"]
        </h1>
        <p class="text-white-50 mb-4">
            @Localizer["Search across <strong class=\"text-white\">{0}</strong> recipes from HowToCook", Model.TotalRecipes.ToString("N0")]
        </p>
        <form method="get" asp-action="Index" asp-controller="Dashboard">
            <div class="input-group input-group-lg mx-auto" style="max-width:640px;">
                <span class="input-group-text bg-white border-end-0">
                    <i data-lucide="search" style="width:20px;height:20px;"></i>
                </span>
                <input type="text"
                       name="q"
                       maxlength="40"
                       class="form-control border-start-0 ps-0"
                       placeholder="@Localizer["Search recipes placeholder"]"
                       value="@Model.Query"
                       autofocus />
                <button class="btn btn-primary px-4" type="submit">@Localizer["Search"]</button>
            </div>
        </form>
    </div>
</div>

@* ── Results ───────────────────────────────────────────────────────── *@
@if (hasQuery)
{
    <div class="d-flex align-items-center mb-3 gap-2">
        <span class="text-muted">
            @Model.TotalResults.ToString("N0") @Localizer[Model.TotalResults == 1 ? "result for" : "results for"]
        </span>
        <code class="fs-6">"@Model.Query"</code>
        @if (Model.UsedAiSearch)
        {
            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                <i class="align-middle me-1" data-lucide="cpu" style="width:14px;height:14px;"></i>
                @Localizer["Search based on AI (Vector Database)"]
            </span>
        }
        @if (Model.RateLimited)
        {
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                <i class="align-middle me-1" data-lucide="alert-triangle" style="width:14px;height:14px;"></i>
                @Localizer["Too many searches. AI search temporarily limited; showing keyword results."]
            </span>
        }
        <a asp-action="Index" asp-controller="Dashboard" class="btn btn-sm btn-outline-secondary ms-auto">
            <i class="align-middle me-1" data-lucide="x"></i> @Localizer["Clear"]
        </a>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i data-lucide="chef-hat" style="width:48px;height:48px;" class="text-muted mb-3 d-block mx-auto"></i>
                <h5 class="text-muted">@Localizer["No recipes found matching"] <code>@Model.Query</code></h5>
                <p class="text-muted small mb-0">@Localizer["Try a shorter name or check spelling."]</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var recipe in Model.Results)
            {
                var cover = recipe.Images.FirstOrDefault(i => i.IsCover);
                var coverUrl = cover != null
                    ? Storage.RelativePathToInternetUrl(cover.LogicalPath) + "?w=400"
                    : null;
                var difficultyStars = new string('★', recipe.Difficulty) + new string('☆', Math.Max(0, 5 - recipe.Difficulty));
                var displayName = Model.LocalizedNames.TryGetValue(recipe.Id, out var ln) ? ln : recipe.Name;
                var displayDesc = Model.LocalizedDescriptions.TryGetValue(recipe.Id, out var ld) ? ld : recipe.Description;
                var categoryDisplay = Model.CategoryDisplayNames.TryGetValue(recipe.Category, out var cn) ? cn : recipe.Category;
                <div class="col-12">
                    <a asp-controller="Recipes" asp-action="Detail" asp-route-id="@recipe.Id"
                       class="card mb-0 shadow-sm text-decoration-none text-body">
                        <div class="card-body py-3">
                            <div class="d-flex align-items-start gap-3">
                                @if (coverUrl != null)
                                {
                                    <img src="@coverUrl" alt="@displayName"
                                         class="rounded-2 object-fit-cover flex-shrink-0"
                                         style="width:64px;height:64px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded-2 d-flex align-items-center justify-content-center bg-primary text-white flex-shrink-0"
                                         style="width:64px;height:64px;">
                                        <i data-lucide="utensils" style="width:28px;height:28px;"></i>
                                    </div>
                                }
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <span class="fs-5 fw-semibold">@displayName</span>
                                        <span class="badge bg-secondary small">@categoryDisplay</span>
                                        <span class="text-warning small">@difficultyStars</span>
                                        @if (Model.LikeCounts.TryGetValue(recipe.Id, out var likes) && likes > 0)
                                        {
                                            <span class="text-muted small">
                                                <i data-lucide="thumbs-up" style="width:13px;height:13px;" class="me-1"></i>@likes
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(displayDesc))
                                    {
                                        <p class="text-muted mb-0 small text-truncate">@displayDesc</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        @* Pagination *@
        @if (totalPages > 1)
        {
            <nav class="mt-4" aria-label="@Localizer["Page navigation"]">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">@Localizer["‹ Prev"]</a>
                    </li>
                    @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(totalPages, Model.Page + 2); p++)
                    {
                        var pageNum = p;
                        <li class="page-item @(pageNum == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@pageNum">@pageNum</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">@Localizer["Next ›"]</a>
                    </li>
                </ul>
            </nav>
        }
    }
}
else
{
    @* ── Top liked recipes with images ─────────────────────────────── *@
    <div class="d-flex align-items-center mb-3 gap-2">
        <i data-lucide="flame" style="width:20px;height:20px;" class="text-danger"></i>
        <h5 class="mb-0 fw-semibold">@Localizer["Most Liked Recipes"]</h5>
        <span class="text-muted small ms-1">@Localizer["{0} recipes with photos", Model.TopTotalWithImages.ToString("N0")]</span>
    </div>

    @if (Model.TopRecipes.Count == 0)
    {
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-4">
                        <i data-lucide="search" style="width:36px;height:36px;" class="text-primary mb-2 d-block mx-auto"></i>
                        <h6 class="fw-semibold">@Localizer["Search Recipes"]</h6>
                        <p class="text-muted small mb-0">@Localizer["Type a recipe name above to search across all recipes with intelligent relevance ranking."]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-4">
                        <i data-lucide="layers" style="width:36px;height:36px;" class="text-success mb-2 d-block mx-auto"></i>
                        <h6 class="fw-semibold">@Localizer["Browse by Category"]</h6>
                        <p class="text-muted small mb-0">@Localizer["Use the sidebar to browse recipes by category or difficulty level."]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center py-4">
                        <i data-lucide="shuffle" style="width:36px;height:36px;" class="text-info mb-2 d-block mx-auto"></i>
                        <h6 class="fw-semibold">@Localizer["Feeling Lucky?"]</h6>
                        <p class="text-muted small mb-0">
                            <a asp-controller="Recipes" asp-action="Random">@Localizer["Try a random recipe"]</a>
                            @Localizer["and discover something new to cook today."]
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3" id="top-recipe-grid">
            @await Html.PartialAsync("_RecipeCards", new Aiursoft.HowToCookViewer.Models.RecipesViewModels.RecipeCardsViewModel
            {
                Recipes = Model.TopRecipes,
                LikeCounts = Model.TopLikeCounts,
                LocalizedNames = Model.TopLocalizedNames,
                LocalizedDescriptions = Model.TopLocalizedDescriptions
            })
        </div>

        @if (Model.TopHasMore)
        {
            <div id="top-load-sentinel" class="text-center py-4" style="min-height:60px;">
                <div class="spinner-border text-secondary" role="status" style="display:none;" id="top-load-spinner">
                    <span class="visually-hidden">@Localizer["Loading…"]</span>
                </div>
            </div>

            <script>
            (function () {
                let nextPage = 2;
                let loading = false;
                let hasMore = true;

                const grid     = document.getElementById('top-recipe-grid');
                const sentinel = document.getElementById('top-load-sentinel');
                const spinner  = document.getElementById('top-load-spinner');

                async function loadMore() {
                    if (loading || !hasMore) return;
                    loading = true;
                    spinner.style.display = '';

                    try {
                        const resp = await fetch('/Dashboard/TopRecipesLoadMore?page=' + nextPage);
                        if (!resp.ok) { hasMore = false; return; }

                        const html = await resp.text();
                        hasMore = resp.headers.get('X-Has-More') === 'true';
                        nextPage++;

                        const tmp = document.createElement('div');
                        tmp.innerHTML = html;
                        while (tmp.firstChild) grid.appendChild(tmp.firstChild);

                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    } finally {
                        loading = false;
                        spinner.style.display = 'none';
                        if (!hasMore) sentinel.style.display = 'none';
                    }
                }

                const observer = new IntersectionObserver(
                    entries => { if (entries[0].isIntersecting) loadMore(); },
                    { rootMargin: '200px' }
                );
                observer.observe(sentinel);
            })();
            </script>
        }
    }
}


<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.HowToCookViewer</AssemblyName>
    <RootNamespace>Aiursoft.HowToCookViewer</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.30" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.32" />
    <PackageReference Include="Aiursoft.Dotlang.AspNetTranslate" Version="10.0.103" />
    <PackageReference Include="Aiursoft.GitRunner" Version="10.0.47" />
    <PackageReference Include="Aiursoft.Scanner" Version="10.0.16" />
    <PackageReference Include="Aiursoft.UiStack" Version="11.0.0" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aiursoft.HowToCookViewer.Tests"></InternalsVisibleTo>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.19" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aiursoft.HowToCookViewer.InMemory\Aiursoft.HowToCookViewer.InMemory.csproj" />
    <ProjectReference Include="..\Aiursoft.HowToCookViewer.MySql\Aiursoft.HowToCookViewer.MySql.csproj" />
    <ProjectReference Include="..\Aiursoft.HowToCookViewer.Sqlite\Aiursoft.HowToCookViewer.Sqlite.csproj" />
  </ItemGroup>
  <Target Name="PrepareFrontendResources" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- Docker supplies the slimmed assets from its Node build stage. -->
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/wwwroot" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/wwwroot" Condition="'$(SkipFrontendBuild)' != 'true'" />
    <Error Condition="!Exists('wwwroot/node_modules/@aiursoft/uistack/dist/css/app.css') Or !Exists('wwwroot/node_modules/@aiursoft/uistack/dist/js/app.js')" Text="The UIStack npm assets are missing. Prepare the frontend before skipping its build."></Error>
    <ItemGroup>
      <Content Remove="wwwroot/node_modules/**/*" />
      <Content Include="wwwroot/node_modules/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>

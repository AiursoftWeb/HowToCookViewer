    <PackageReference Include="Aiursoft.Scanner" Version="10.0.15" />
    <PackageReference Include="Aiursoft.UiStack" Version="10.0.32" />
    <PackageReference Include="Aiursoft.WebTools" Version="10.0.21" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aiursoft.HowToCookViewer.Tests"></InternalsVisibleTo>
    <PackageReference Include="Aiursoft.Canon.ScheduledTasks" Version="10.0.18" />

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Aiursoft.HowToCookViewer</AssemblyName>
    <RootNamespace>Aiursoft.HowToCookViewer</RootNamespace>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aiursoft.ClickhouseLoggerProvider" Version="10.0.28" />
    <PackageReference Include="Aiursoft.DbTools.Switchable" Version="10.0.30" />
    <PackageReference Include="Aiursoft.Dotlang.AspNetTranslate" Version="10.0.86" />
